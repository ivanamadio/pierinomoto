---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<Layout
  title="Ricambi Moto e Scooter | Pierino Moto Ascoli Piceno"
  description="Ricambi, accessori e prodotti per moto, scooter e moto d'epoca ad Ascoli Piceno. Pierino Moto dal 1953."
>

<Header />

<!-- HERO -->

<section class="hero">
  <div class="overlay">
    <div class="container hero-content">

      <span class="badge">PIERINO MOTO · DAL 1953</span>

      <h1>Ricambi e accessori<br />per le tue due ruote</h1>

      <p>
        Da oltre 70 anni selezioniamo ricambi e accessori
        per moto, scooter e moto d'epoca, con esperienza
        e attenzione alle esigenze di ogni motociclista.
      </p>

    </div>
  </div>
</section>


<!-- INTRO -->

<section class="intro">

  <div class="container">

    <span class="section-label">COSA TROVI IN NEGOZIO</span>

    <h2>Ricambi, accessori e competenza</h2>

    <p>
      Cerchiamo di offrire un'ampia scelta di prodotti per la
      manutenzione e la cura della tua moto. Se non trovi quello
      che cerchi, contattaci: possiamo aiutarti nella ricerca
      del ricambio.
    </p>

  </div>

</section>


<!-- CATEGORIE -->

<section class="categorie">

  <div class="container">

    <div class="cards">


      <!-- RICAMBI -->

      <article class="card">

        <div class="icon">🔧</div>

        <h2>Ricambi meccanici</h2>

        <p>
          Componenti per motore, trasmissione, filtri,
          frizione, cuscinetti, guarnizioni e parti soggette
          a usura.
        </p>

      </article>


      <!-- FRENI -->

      <article class="card">

        <div class="icon">🛑</div>

        <h2>Impianto frenante</h2>

        <p>
          Pastiglie, dischi, tubazioni, liquidi freno
          e componenti per la manutenzione dell'impianto
          frenante.
        </p>

      </article>


      <!-- ELETTRICO -->

      <article class="card featured">

        <div class="card-image">

          <img
            src="/immagini/candele.jpg"
            alt="Candele per moto e scooter"
          />

        </div>

        <div class="card-body">

          <span class="small-label">DISPONIBILI IN NEGOZIO</span>

          <h2>Candele e ricambi elettrici</h2>

          <p>
            Candele, lampadine, batterie, fusibili,
            regolatori e altri componenti dell'impianto
            elettrico.
          </p>

        </div>

      </article>


      <!-- LUBRIFICANTI -->

      <article class="card">

        <div class="icon">🛢️</div>

        <h2>Lubrificanti</h2>

        <p>
          Oli motore, oli forcella, liquidi refrigeranti,
          liquidi freni e prodotti per la manutenzione
          della moto.
        </p>

      </article>


      <!-- ACCESSORI -->

      <article class="card">

        <div class="icon">🪖</div>

        <h2>Caschi e accessori</h2>

        <p>
          Caschi, guanti, antipioggia, bauletti e accessori
          per rendere più pratici e sicuri i tuoi viaggi
          in moto.
        </p>

      </article>


      <!-- EPOCA -->

      <article class="card">

        <div class="icon">🏁</div>

        <h2>Moto d'epoca</h2>

        <p>
          Esperienza nella ricerca di ricambi per moto
          storiche e modelli fuori produzione.
        </p>

      </article>

    </div>

  </div>

</section>


<!-- MARCHI -->

<section class="marchi">

  <div class="container">

    <span class="section-label">I NOSTRI PARTNER</span>

    <h2>I marchi trattati</h2>

    <p>
      Lavoriamo con diversi marchi del settore per offrire
      ricambi e prodotti adatti alle diverse esigenze.
    </p>

    <img
      src="/immagini/marchi.jpg"
      alt="Marchi trattati da Pierino Moto"
    />

  </div>

</section>


<!-- RICERCA RICAMBIO -->

<section class="ricerca">

  <div class="container">

    <div class="ricerca-box">

      <span class="badge">HAI BISOGNO DI UN RICAMBIO?</span>

      <h2>Non trovi quello che cerchi?</h2>

      <p>
        Indicaci marca, modello e anno della tua moto.
        Ti aiuteremo a trovare il ricambio più adatto.
      </p>

      <div class="azioni">

        <a
          class="btn rosso"
          href="tel:+390736251205"
        >
          📞 Chiama il negozio
        </a>

        <a
          class="btn whatsapp"
          href="https://wa.me/393497774290"
          target="_blank"
          rel="noopener noreferrer"
        >
          💬 Scrivici su WhatsApp
        </a>

      </div>

    </div>

  </div>

</section>


</Layout>


<style>

:global(body) {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: #f7f7f7;
  color: #222;
}


/* GENERALE */

.container {
  max-width: 1100px;
  margin: auto;
  padding: 0 20px;
}


/* HERO */

.hero {
  min-height: 520px;
  background-image: url("/immagini/oggi.jpg");
  background-size: cover;
  background-position: center;
}

.overlay {
  min-height: 520px;
  background: rgba(0, 0, 0, 0.62);
  display: flex;
  align-items: center;
}

.hero-content {
  color: white;
  padding-top: 50px;
  padding-bottom: 50px;
}

.badge {
  display: inline-block;
  background: #d71920;
  color: white;
  padding: 9px 18px;
  border-radius: 30px;
  font-size: 0.82rem;
  font-weight: bold;
  letter-spacing: 0.5px;
  margin-bottom: 20px;
}

.hero h1 {
  font-size: 3.5rem;
  line-height: 1.1;
  max-width: 750px;
  margin: 0 0 25px;
}

.hero p {
  max-width: 700px;
  font-size: 1.2rem;
  line-height: 1.7;
  color: #f1f1f1;
}


/* INTRO */

.intro {
  background: white;
  text-align: center;
  padding: 75px 20px 45px;
}

.intro .container {
  max-width: 800px;
}

.section-label {
  display: block;
  color: #d71920;
  font-size: 0.82rem;
  font-weight: bold;
  letter-spacing: 1px;
  margin-bottom: 12px;
}

.intro h2,
.marchi h2 {
  font-size: 2.4rem;
  margin: 0 0 20px;
}

.intro p,
.marchi p {
  font-size: 1.08rem;
  line-height: 1.7;
  color: #555;
}


/* CATEGORIE */

.categorie {
  padding: 55px 20px 80px;
  background: white;
}

.cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}

.card {
  background: #f8f8f8;
  border-radius: 15px;
  overflow: hidden;
  box-shadow: 0 5px 18px rgba(0, 0, 0, 0.07);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.card:hover {
  transform: translateY(-5px);
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
}

.icon {
  font-size: 2.5rem;
  padding: 28px 28px 0;
}

.card h2 {
  color: #d71920;
  font-size: 1.35rem;
  margin: 15px 28px 12px;
}

.card p {
  line-height: 1.65;
  color: #555;
  margin: 0;
  padding: 0 28px 30px;
}


/* CARD CON FOTO */

.card-image {
  width: 100%;
  height: 220px;
  overflow: hidden;
}

.card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.card-body {
  padding-top: 22px;
}

.card-body h2 {
  margin-top: 8px;
}

.small-label {
  display: block;
  padding: 0 28px;
  color: #d71920;
  font-size: 0.75rem;
  font-weight: bold;
  letter-spacing: 0.8px;
}


/* MARCHI */

.marchi {
  padding: 80px 20px;
  background: #f5f5f5;
  text-align: center;
}

.marchi .container {
  max-width: 950px;
}

.marchi img {
  display: block;
  width: 100%;
  max-width: 900px;
  margin: 35px auto 0;
  border-radius: 12px;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
}


/* CONTATTI */

.ricerca {
  padding: 80px 20px;
  background: white;
}

.ricerca-box {
  max-width: 800px;
  margin: auto;
  background: #111;
  color: white;
  border-radius: 18px;
  padding: 60px;
  text-align: center;
}

.ricerca-box h2 {
  font-size: 2.4rem;
  margin: 5px 0 20px;
}

.ricerca-box p {
  color: #ddd;
  font-size: 1.1rem;
  line-height: 1.7;
}

.azioni {
  display: flex;
  justify-content: center;
  gap: 15px;
  flex-wrap: wrap;
  margin-top: 30px;
}

.btn {
  display: inline-block;
  padding: 15px 25px;
  border-radius: 8px;
  color: white;
  text-decoration: none;
  font-weight: bold;
}

.rosso {
  background: #d71920;
}

.whatsapp {
  background: white;
  color: #111;
}


/* TABLET */

@media (max-width: 900px) {

  .cards {
    grid-template-columns: repeat(2, 1fr);
  }

  .hero h1 {
    font-size: 3rem;
  }

}


/* CELLULARE */

@media (max-width: 650px) {

  .hero,
  .overlay {
    min-height: 450px;
  }

  .hero h1 {
    font-size: 2.35rem;
  }

  .hero p {
    font-size: 1rem;
  }

  .cards {
    grid-template-columns: 1fr;
  }

  .intro h2,
  .marchi h2 {
    font-size: 2rem;
  }

  .ricerca-box {
    padding: 40px 25px;
  }

  .ricerca-box h2 {
    font-size: 2rem;
  }

  .btn {
    width: 100%;
    max-width: 300px;
  }

}

</style>